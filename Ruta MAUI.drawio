        <mxCell id="60da8b9f42644d3a-33" value="MAUI se consolida como la opción recomendada frente a Xamarin, con mejoras en tooling, hot reload y soporte más maduro para desktop (Windows/Mac) además de móvil." style="text;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;shadow=0;fontSize=15;fontColor=#330000;spacingLeft=6;spacingRight=5;labelBackgroundColor=none;labelBorderColor=none;textShadow=0;whiteSpace=wrap;html=1;convertToSvg=0;" parent="1" vertex="1">
